{
  // Las pruebas se comprueban aparte de la aplicación por una razón: una de
  // ellas lee `supabase/*.sql` del disco para que la copia de seguridad no se
  // quede vieja en silencio, y eso son tipos de Node. Metiendo Node en la
  // configuración de la aplicación, el día de mañana cualquier pantalla podría
  // importar `node:fs` sin que nadie se enterase hasta el despliegue.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.pruebas.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  // El `exclude` de la aplicación se hereda, y aquí deja fuera justo lo que hay
  // que mirar: se borra.
  "exclude": [],
  "include": ["src/**/*.prueba.ts", "src/pruebas"]
}
